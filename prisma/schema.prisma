// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum EmailStatus {
  RECEIVED
  PROCESSING
  CLASSIFIED
  EXTRACTED
  FAILED
}

enum EmailCategory {
  SUPPORT_REQUEST
  BILLING
  SALES_INQUIRY
  COMPLAINT
  SPAM
  OTHER
}

enum EmailSentiment {
  POSITIVE
  NEUTRAL
  NEGATIVE
}

enum EmailUrgency {
  LOW
  MEDIUM
  HIGH
}

model Email {
  id                String          @id @default(cuid())
  messageId         String          @unique
  from              String
  to                String
  subject           String
  body              String
  status            EmailStatus     @default(RECEIVED)
  category          EmailCategory?
  sentiment         EmailSentiment?
  urgency           EmailUrgency?
  summary           String?
  extractedEntities Json?
  receivedAt        DateTime
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
}
